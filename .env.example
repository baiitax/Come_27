# Gwarzo 2027 — environment variables
#
# Copy these into your host's environment (Vercel → Project → Settings →
# Environment Variables). NEVER commit a real .env file.
#
# ---------------------------------------------------------------------------
# DATABASE_URL  (required)
#   Supabase DIRECT/SESSION connection string (port 5432 — NOT the 6543
#   transaction pooler). Supabase → Project Settings → Database →
#   Connection string → "Direct connection".
#
#   IMPORTANT: if the password contains an '@' character it MUST be written
#   as %40 inside this URL, or the string will parse to the wrong password
#   and you will get Prisma error P1001 (authentication rejected).
#
#   Format:
#     postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD_WITH_%40_IF_NEEDED>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional: dedicated direct connection used by the runtime self-healer for
# DDL (migrations) and seeding. Defaults to DATABASE_URL when absent.
# DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# AUTH_SECRET  (required)
#   Random string, 32+ characters. Signs admin session cookies.
#   Generate:  openssl rand -hex 32
#   Keep it IDENTICAL across all deploys or existing admin logins invalidate.
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-openssl-rand-hex-32"
